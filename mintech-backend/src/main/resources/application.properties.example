spring.application.name=mintech-backend
server.port=8081
spring.datasource.url=jdbc:mysql://localhost:3306/mintech_ecommerce?serverTimezone=UTC
spring.datasource.username=${MINTECH_DB_USER}
spring.datasource.password=${MINTECH_DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=none
spring.jpa.properties.hibernate.type.preferred_uuid_jdbc_type=CHAR
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

jwt.secret=${MINTECH_JWT_SECRET}
jwt.expiration=${MINTECH_JWT_EXPIRATION:3600000}
